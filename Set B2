<?php
session_start();

// Initialize login attempts counter
if (!isset($_SESSION['attempts'])) {
    $_SESSION['attempts'] = 0;
}

if (isset($_POST['submit'])) {
    // Lock out user after 3 failed attempts
    if ($_SESSION['attempts'] >= 3) {
        echo "Try Again Later!";
        exit();
    }

    $un = $_POST['un'];
    $pass = $_POST['pass'];

    // Check credentials
    if ($un == "admin" && $pass == "1234") {
        $_SESSION['attempts'] = 0;
        header("Location: user2.php");
        exit();
    } else {
        $_SESSION['attempts']++;
        echo "Invalid Username and Password!<br>";
        echo "Attempts Used: " . $_SESSION['attempts'];
    }
}
?>

